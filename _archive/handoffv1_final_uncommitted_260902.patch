 from dfn_analysis.reconstruct_discs_from_traces import _plane_basis
 
+
+def _face_plane_from_traces(p0_f, p1_f):
+    """면의 실제 평면(단위법선, 중심)을 그 면 절리선 끝점에서 SVD 적합한다.
+    실측 막장면은 터널축과 수 도 기울어 있어(본 데이터 ~8°), x=const 이상화 평면으로
+    disc를 자르면 현이 기울기만큼 변위되어 재현 판정이 인위적으로 나빠진다."""
+    pts = np.vstack([p0_f, p1_f])
+    c = pts.mean(axis=0)
+    _, _, vt = np.linalg.svd(pts - c, full_matrices=False)
+    return vt[2] / np.linalg.norm(vt[2]), c
+
+
+def _disc_chord_on_face_plane(center, normal, radius, n_f, c_f, poly_ccw):
+    """disc를 '실제 막장면 평면'으로 잘라 관측창(yz)으로 클리핑한 현 (yz 끝점 쌍)."""
+    t = np.cross(normal, n_f)
+    nt = np.linalg.norm(t)
+    if nt < 1e-9:
+        return None
+    t = t / nt
+    A = np.vstack([normal, n_f, t])
+    b = np.array([normal @ center, n_f @ c_f, t @ center])
+    try:
+        q = np.linalg.solve(A, b)
+    except np.linalg.LinAlgError:
+        return None
+    w = center - q
+    s_mid = float(w @ t)
+    h2 = radius ** 2 - (float(w @ w) - s_mid ** 2)
+    if h2 <= 0.0:
+        return None
+    h = math.sqrt(h2)
+    e0, e1 = q + (s_mid - h) * t, q + (s_mid + h) * t
+    clipped = clip_segment_to_convex_polygon(e0[1:], e1[1:], poly_ccw)
+    if clipped is None:
+        return None
+    q0, q1 = clipped
+    if np.linalg.norm(q1 - q0) < 1e-6:
+        return None
+    return q0, q1
+
