# Data files (Large) - Absolutely exclude from Git
*.h5
*.npy
*.mat
*.pyc

# Directories containing large datasets or results
storage/data/
storage/output/
"dfn generator v1/src/main/dfn_output_*"
# Archived experiment outputs (preserved on disk, kept out of git history)
_archive/**/storage/output/
_archive/**/storage/data/

# Python
__pycache__/
*.py[cod]
*$py.class

# Local environment/IDE
.venv/
venv/
.idea/
.vscode/
.DS_Store

# Handoff demo outputs and packaging artifact (regenerable, kept out of git history)
handoffv1/demo_output/
handoffv1.zip

# Client sample data & large point clouds (kept out of git)
handoffv1/demodata/
WP_aligned_3_2412.bin

# handoffv2 대용량 데이터·재생성 가능 출력 (파이프라인으로 재생성)
handoffv2/demodata/
handoffv2/demo_output/
handoffv2/example_io/paraview/full/
handoffv2/example_io/paraview/top30/
handoffv2/example_io/paraview/windows/
handoffv2/example_io/blocks_edgecut/
deliverables/**/*.json
v2.zip

# MC 확률장 복셀 필드 (재생성 가능, 대용량)
handoffv2/example_io/**/*.vti
handoffv2/example_io/**/*.vts
