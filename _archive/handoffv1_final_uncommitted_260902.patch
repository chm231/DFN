index 4dd6aba..f58125c 100644
--- a/handoffv1/run_demo.py
+++ b/handoffv1/run_demo.py
@@ -104,6 +104,20 @@ def fill_reference_p32(p32_csv, site):
 
 
 def main():
+    # ------------------------------------------------------------------------
+    # [CLI 인자 요약] — 자세한 도움말: --help
+    #   --seed        : 기본 2026 — DFN 생성 난수 시드
+    #   --site        : {laxemar,forsmark}, 기본 laxemar — 벤치마크 사이트 (참값 파라미터 세트)
+    #   --face-x      : 기본 [0.0, 1.0, 2.0, 3.0], 복수값 — 관측 막장면 x 위치 [m]
+    #   --outdir      : 출력 폴더 (기본: demo_output/seed<seed>)
+    #   --n-bootstrap : 기본 100 — k_r bootstrap 반복 수 (0 = 신뢰구간 생략, 실행 단축)
+    #   --rmax-local  : 기본 25.0 — 조건부 생성의 국소 반지름 상한 [m]
+    #   --lmin-det    : 기본 0.5 — 검출 하한 [m] (조건부 생성의 관측 모순 판정에 사용)
+    #   --skip-3d     : 플래그 — 3차원 시각화 생략
+    #   --p32-fisher  : {preset,estimated}, 기본 preset — P32 환산계수 C=E[sin phi] 의 방향분포 소스.
+    #                     preset = 사이트 방향 모델 표(보고서 표 6-5 수치 재현), estimated = 이번 실행에서 역산한
+    #                     방향분포(자기완결)
+    # ------------------------------------------------------------------------
     ap = argparse.ArgumentParser(description="DFN 역산 파이프라인 데모 러너",
                                  formatter_class=argparse.ArgumentDefaultsHelpFormatter)
     ap.add_argument("--seed", type=int, default=2026, help="DFN 생성 난수 시드")
