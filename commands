# ============================================================
# DFN Modeling & Block Detection Pipeline Commands
# ============================================================

# [환경 설정] 실행 전 항상 PYTHONPATH를 현재 디렉토리로 설정해야 합니다.
$env:PYTHONPATH = "."

# ------------------------------------------------------------
# Package A: 직접 DFN 분석 및 블록 판별 (Ground Truth)
# ------------------------------------------------------------
# 스크립트: dfn_analysis/run_dfn_pipeline.py
# 주요 Argument:
#   --input         [str]   [필수] HDF5 DFN 데이터 경로
#   --voxel_size    [float] 복셀 크기 (m) (기본값: 0.5)
#   --halo          [float] 터널 주변 해석 반경 (m) (기본값: 10.0)
#   --tol_factor    [float] 균열 슬랩 두께 계수 (기본값: 0.5)
#   --min_voxels    [int]   블록으로 인정할 최소 복셀 수 (기본값: 8)
#   --connectivity  [int]   CCA 연결성 (6 또는 26) (기본값: 6)
#   --no_gpu        [flag]  GPU 가속 비활성화
#   --show_fractures [flag] 시각화 시 경계 균열 패치 표시
& "C:\Users\user\miniconda3\python.exe" dfn_analysis/run_dfn_pipeline.py --input storage/data/dfn_export_for_python.h5 --voxel_size 0.01 --halo 8 --tol_factor 0.5 --min_voxels 5000



# ------------------------------------------------------------
# Utility: 2개 연속 막장 기반 균열 복원 (전방 예측용)
# ------------------------------------------------------------
# 스크립트: trace_analysis/run_two_face_reconstruction.py
# 주요 Argument:
#   --x_curr       [float] 현재 막장 위치 (m)
#   --interval     [float] 막장 간격 (m) (기본값: 3.0)
#   --forward_dist [float] 예측 전방 거리 (m) (기본값: 5.0)
#   --halo         [float] 터널 주변 반경 (m) (기본값: 10.0)
#   --visualize    [flag]  3D 시각화 실행
& "C:\Users\user\miniconda3\python.exe" trace_analysis/run_two_face_reconstruction.py --x_curr 20.0 --interval 3.0 --forward_dist 5.0 --halo 10.0 --visualize

# ------------------------------------------------------------
# Package C: SC-PMFR (절리군 제약 확률적 복원 프로토타입)
# ------------------------------------------------------------
# 스크립트: trace_analysis/reconstruction/main_reconstruct.py
# 설명:
#   절리군(Fracture Set) 추론 정보를 매칭 Prior로 사용하여
#   연속 막장(2~3개)으로부터 3D 원판을 확률적으로 복원함.
# 주요 기능:
#   - 법선 매니폴드 기반 절리군 자동 추론
    - 확률적 가중 매칭 (Set/Geometry/Continuity)
    - 제약 조건 하의 수치 최적화 평면 피팅
& "C:\Users\user\miniconda3\python.exe" -m trace_analysis.reconstruction.main_reconstruct --x_curr 20.0 --num_faces 3 --visualize





& "C:\Users\user\miniconda3\python.exe" trace_analysis/run_trace_pipeline.py

# ------------------------------------------------------------
# Utility: 2D Trace Map 시각화
# ------------------------------------------------------------
# 스크립트: trace_analysis/plot_2d_trace_map.py
# 주요 Argument:
#   --input         [str]   [필수] HDF5 DFN 파일 경로
& "C:\Users\user\miniconda3\python.exe" trace_analysis/plot_2d_trace_map.py --input storage/data/dfn_export_for_python.h5


# ------------------------------------------------------------
# Utility: CAD 데이터 수동 추출 (기존 방식)
# ------------------------------------------------------------
# 스크립트: dfn_analysis/export_traces_to_cad.py
# 주요 Argument:
#   --input         [str]   입력 Trace CSV 경로
#   --outdir        [str]   저장할 디렉토리 경로
& "C:\Users\user\miniconda3\python.exe" dfn_analysis/export_traces_to_cad.py --input storage/output/inverse_results/synthetic_face_traces.csv --outdir storage/output/cad_export
