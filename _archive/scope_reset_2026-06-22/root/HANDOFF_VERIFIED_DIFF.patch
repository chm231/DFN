+def _compute_method_b_dynamically() -> dict:
+    import pandas as pd
+    from dfnrec.geometry.vector import trend_plunge_from_normal, normalize
+    from dfnrec.orientation.fisher_mle import _kappa_mle
+    
+    csv_path = "storage/output/ground_truth_traces_with_normals.csv"
+    if not os.path.exists(csv_path):
+        return {
+            "S1": dict(trend=160.58, plunge=6.28,  kappa=18.51, kr=None, P32=None),
+            "S2": dict(trend=279.14, plunge=0.91,  kappa=16.68, kr=None, P32=None),
+            "S3": dict(trend=216.25, plunge=0.96,  kappa=10.02, kr=None, P32=None),
+            "S4": dict(trend=185.76, plunge=64.31, kappa=11.88, kr=None, P32=None),
+            "S5": dict(trend=66.41,  plunge=29.12, kappa=13.40, kr=None, P32=None),
+        }
+        
+    df = pd.read_csv(csv_path)
+    res_b = {}
+    for s_idx in [1, 2, 3, 4, 5]:
+        sid = f"S{s_idx}"
+        df_sub = df[df["set_id"] == s_idx]
+        if len(df_sub) == 0:
+            continue
+            
+        normals = df_sub[["normal_x", "normal_y", "normal_z"]].values
+        valid_normals = []
+        T = np.zeros((3, 3))
+        for n_vec in normals:
+            try:
+                n_unit = normalize(n_vec)
+                valid_normals.append(n_unit)
+                T += np.outer(n_unit, n_unit)
+            except ValueError:
+                continue
+        if len(valid_normals) < 2:
+            continue
+        T /= len(valid_normals)
+        
+        evals, evecs = np.linalg.eigh(T)
+        mean_dir = evecs[:, 2]
+        
+        flipped = []
+        for n_unit in valid_normals:
+            if np.dot(n_unit, mean_dir) < 0:
+                flipped.append(-n_unit)
+            else:
+                flipped.append(n_unit)
+        flipped = np.array(flipped)
+        R = float(np.sum(np.dot(flipped, mean_dir)))
+        R_bar = R / len(valid_normals)
+        kappa = _kappa_mle(min(R_bar, 1.0 - 1e-9))
+        
+        trend, plunge = trend_plunge_from_normal(mean_dir)
+        res_b[sid] = dict(trend=trend, plunge=plunge, kappa=kappa, kr=None, P32=None)
+    return res_b
+
+METHOD_B = _compute_method_b_dynamically()
 
 
